# Copy to .env and fill in. NEVER commit .env.
BASE_SEPOLIA_RPC=https://<your-quicknode-or-alchemy-endpoint>
BASE_SEPOLIA_RPC_FALLBACK=https://sepolia.base.org
GRAPH_DEPLOY_KEY=<32-char hex deploy key from your Studio subgraph page>
GRAPH_API_KEY=<32-char hex query key from Subgraph Studio>
SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/proof-of-fill/<version>
# Solvent mainnet indexes (real 1inch Aqua makers)
SUBGRAPH_URL_BASE=https://api.studio.thegraph.com/query/<id>/solvent-base/<version>
SUBGRAPH_URL_ARBITRUM=https://api.studio.thegraph.com/query/<id>/solvent-arbitrum/<version>
SUBGRAPH_URL_OPTIMISM=https://api.studio.thegraph.com/query/<id>/solvent-optimism/<version>
BASESCAN_API_KEY=<basescan api key>
ANTHROPIC_API_KEY=<anthropic api key>
MNEMONIC=<12-word mnemonic for the 26 demo wallets>
DEPLOYER_KEY=<deployer private key, or derive from MNEMONIC>
