# Copy to .env. NEVER commit .env.
# The defaults below are enough for the dashboard, the mainnet analysis, and every
# read-only check. A funded MNEMONIC is only needed to send transactions
# (vignette, demos, attestor, deploys).

BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_RPC_FALLBACK=https://sepolia.base.org

# Public query endpoints (live, no key needed)
SUBGRAPH_URL=https://api.studio.thegraph.com/query/42912/solvent-sepolia/v0.8.0
SUBGRAPH_URL_BASE=https://api.studio.thegraph.com/query/42912/solvent-base/v0.2.0
SUBGRAPH_URL_ARBITRUM=https://api.studio.thegraph.com/query/42912/solvent-arbitrum/v0.2.0
SUBGRAPH_URL_OPTIMISM=https://api.studio.thegraph.com/query/42912/solvent-optimism/v0.2.0

# Only needed to send transactions or deploy
MNEMONIC=<12-word mnemonic for the demo wallets>

# Only needed to publish subgraph versions / verify contracts
GRAPH_DEPLOY_KEY=<deploy key from your Studio subgraph page>
BASESCAN_API_KEY=<etherscan v2 api key>
