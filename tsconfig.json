{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@aqua-solvent/core": ["packages/core/src/index.ts"] }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "agents/**/*.ts", "services/**/*.ts"]
}
