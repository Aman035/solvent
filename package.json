{
  "name": "solvent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test",
    "fmt:contracts": "cd contracts && forge fmt",
    "wallets": "tsx scripts/balances.ts",
    "fund": "tsx scripts/fund.ts",
    "verify:all": "tsx scripts/verify/all.ts",
    "test": "vitest run",
    "attest": "tsx services/attestor/src/index.ts --once",
    "attest:watch": "tsx services/attestor/src/index.ts",
    "alice": "tsx scripts/maker.ts",
    "attest:failures": "tsx services/attestor/src/scan.ts",
    "verify": "tsx scripts/verify/all.ts",
    "attack:wash": "tsx scripts/attack/wash-trade.ts",
    "attack:reviews": "tsx scripts/attack/sybil-reviews.ts",
    "attack:simulate": "tsx scripts/attack/simulate-scores.ts",
    "attack:all": "tsx scripts/attack/wash-trade.ts 3 2 && tsx scripts/attack/sybil-reviews.ts && tsx scripts/attack/simulate-scores.ts && tsx scripts/attack/report.ts",
    "dash": "cd dashboard && vite",
    "dash:build": "cd dashboard && vite build",
    "dash:preview": "cd dashboard && vite preview --port 4173",
    "demo:reset": "tsx scripts/demo/reset.ts",
    "attest:books": "tsx services/attestor/src/attest-books.ts",
    "seed:agents": "tsx scripts/seed-agents.ts",
    "seed:fills": "tsx scripts/seed-fills.ts",
    "demo": "tsx scripts/demo/walkthrough.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aqua-solvent/core": "workspace:*",
    "dotenv": "^16.4.7",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "type": "module"
}
